# Copy to infra/.env to override defaults used by docker-compose.yml
# All defaults are for local development only.
POSTGRES_DB=itsm
POSTGRES_USER=itsm
POSTGRES_PASSWORD=itsm
POSTGRES_PORT=5432
BACKEND_PORT=8080

KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Applied only when the Postgres volume is created (docker compose down -v to re-init)
KEYCLOAK_DB_PASSWORD=keycloak
