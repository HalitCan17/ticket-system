<?xml version="1.0" encoding="UTF-8"?>
<!-- jBPM spike (Aşama 0): Start -> single user task "Review" -> End. See docs/jbpm-spike.md -->
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:drools="http://www.jboss.org/drools"
                   id="_spikeApprovalDefinitions"
                   exporter="hand-written"
                   targetNamespace="http://www.omg.org/bpmn20">

  <bpmn2:itemDefinition id="_ticketIdItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_approvedItem" structureRef="Boolean"/>
  <bpmn2:itemDefinition id="__Review_TaskNameInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__Review_GroupIdInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__Review_ticketIdInputXItem" structureRef="String"/>
  <bpmn2:itemDefinition id="__Review_approvedOutputXItem" structureRef="Boolean"/>

  <bpmn2:process id="spikeApproval" name="Spike approval" isExecutable="true" processType="Public"
                 drools:packageName="com.itsm.backend.spike" drools:version="1.0" drools:adHoc="false">

    <bpmn2:property id="ticketId" itemSubjectRef="_ticketIdItem" name="ticketId"/>
    <bpmn2:property id="approved" itemSubjectRef="_approvedItem" name="approved"/>

    <bpmn2:startEvent id="_Start" name="Start">
      <bpmn2:outgoing>_Flow_StartToReview</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:sequenceFlow id="_Flow_StartToReview" sourceRef="_Start" targetRef="_Review"/>

    <bpmn2:userTask id="_Review" name="Review">
      <bpmn2:incoming>_Flow_StartToReview</bpmn2:incoming>
      <bpmn2:outgoing>_Flow_ReviewToEnd</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="_Review_TaskNameInputX" drools:dtype="Object" itemSubjectRef="__Review_TaskNameInputXItem" name="TaskName"/>
        <bpmn2:dataInput id="_Review_GroupIdInputX" drools:dtype="Object" itemSubjectRef="__Review_GroupIdInputXItem" name="GroupId"/>
        <bpmn2:dataInput id="_Review_ticketIdInputX" drools:dtype="String" itemSubjectRef="__Review_ticketIdInputXItem" name="ticketId"/>
        <bpmn2:dataOutput id="_Review_approvedOutputX" drools:dtype="Boolean" itemSubjectRef="__Review_approvedOutputXItem" name="approved"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>_Review_TaskNameInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Review_GroupIdInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>_Review_ticketIdInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>_Review_approvedOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Review_TaskNameInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">Review</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Review_TaskNameInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>_Review_GroupIdInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression">AGENT</bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression">_Review_GroupIdInputX</bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>ticketId</bpmn2:sourceRef>
        <bpmn2:targetRef>_Review_ticketIdInputX</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>_Review_approvedOutputX</bpmn2:sourceRef>
        <bpmn2:targetRef>approved</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:userTask>

    <bpmn2:sequenceFlow id="_Flow_ReviewToEnd" sourceRef="_Review" targetRef="_End"/>

    <bpmn2:endEvent id="_End" name="End">
      <bpmn2:incoming>_Flow_ReviewToEnd</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>

  <bpmndi:BPMNDiagram id="_spikeApprovalDiagram">
    <bpmndi:BPMNPlane id="_spikeApprovalPlane" bpmnElement="spikeApproval">
      <bpmndi:BPMNShape id="shape__Start" bpmnElement="_Start">
        <dc:Bounds height="56" width="56" x="100" y="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__Review" bpmnElement="_Review">
        <dc:Bounds height="102" width="154" x="236" y="77"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape__End" bpmnElement="_End">
        <dc:Bounds height="56" width="56" x="470" y="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge__Flow_StartToReview" bpmnElement="_Flow_StartToReview">
        <di:waypoint x="156" y="128"/>
        <di:waypoint x="236" y="128"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge__Flow_ReviewToEnd" bpmnElement="_Flow_ReviewToEnd">
        <di:waypoint x="390" y="128"/>
        <di:waypoint x="470" y="128"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
